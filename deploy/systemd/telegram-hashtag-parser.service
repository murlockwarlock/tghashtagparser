[Unit]
Description=Telegram Hashtag Parser Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/telegram-hashtag-parser/current
EnvironmentFile=/opt/telegram-hashtag-parser/shared/.env
Environment=LOG_DIR=/opt/telegram-hashtag-parser/shared/logs
ExecStart=/opt/telegram-hashtag-parser/current/venv/bin/python -m app.main
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
